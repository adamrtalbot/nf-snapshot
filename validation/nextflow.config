// The plugin is passed with `-plugins` for runs and declared here for plugin commands.
plugins { id "nf-snapshot@${System.getenv('NF_SNAPSHOT_VERSION')}" }
profiles {
    snap {
        snapshot {
            enabled  = true
            file     = 'snapshot.json'
            ignore   = ['gz/index.csv']
            nameOnly = ['**/*.log']
        }
    }
}
